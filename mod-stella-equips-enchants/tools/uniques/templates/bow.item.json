{
	"model": {
		"type": "minecraft:condition",
		"on_false": {
			"type": "minecraft:model",
			"model": "{ns}:item/{id}"
		},
		"on_true": {
			"type": "minecraft:range_dispatch",
			"entries": [
				{
					"model": {
						"type": "minecraft:model",
						"model": "{ns}:item/{id}_pulling_1"
					},
					"threshold": 0.65
				},
				{
					"model": {
						"type": "minecraft:model",
						"model": "{ns}:item/{id}_pulling_2"
					},
					"threshold": 0.9
				}
			],
			"fallback": {
				"type": "minecraft:model",
				"model": "{ns}:item/{id}_pulling_0"
			},
			"property": "minecraft:use_duration",
			"scale": 0.1
		},
		"property": "minecraft:using_item"
	}
}
