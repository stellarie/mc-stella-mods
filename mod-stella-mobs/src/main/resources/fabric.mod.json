{
	"schemaVersion": 1,
	"id": "mod-stella-mobs",
	"version": "${version}",
	"name": "Stella Mobs",
	"description": "Mob AI, gear, and behavior changes, and three slime mobs, for a private server.",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.stella.mobs.StellaMobs"
		],
		"client": [
			"com.stella.mobs.client.StellaMobsClient"
		]
	},
	"mixins": [
		"mod-stella-mobs.mixins.json",
		{
			"config": "mod-stella-mobs.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
