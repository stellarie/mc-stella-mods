{
	"schemaVersion": 1,
	"id": "mod-stella-spells",
	"version": "${version}",
	"name": "Stella Spellbooks",
	"description": "Server-side spell logic and client-side spellbook visuals.",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.stella.spells.Spellbooks"
		],
		"client": [
			"com.stella.spells.SpellTooltipClient"
		]
	},
	"mixins": [
		"mod-stella-spells.mixins.json",
		{
			"config": "mod-stella-spells.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"mod-stella-mobs": "*"
	}
}
